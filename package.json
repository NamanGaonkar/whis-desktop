{
  "name": "whis-desktop",
  "version": "1.0.0",
  "description": "Production desktop terminal and workspace for the Whis CLI agent",
  "main": "./out/main/index.js",
  "author": "Whis Team",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "node tools/package.cjs",
    "package:win": "node tools/package.cjs --win",
    "package:mac": "node tools/package.cjs --mac",
    "package:linux": "node tools/package.cjs --linux",
    "deploy:local": "powershell -ExecutionPolicy Bypass -File tools/deploy-local.ps1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "node-pty": "^1.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.2.8",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "resedit": "^2.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
